# Copy this file to .env and fill in values before starting the stack.
# Never commit .env to version control.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_app

# --- Backend ---
# Async MySQL URL (used by SQLAlchemy + Alembic)
DATABASE_URL=mysql+asyncmy://app_user:change_me_app@mysql:3306/qna

# Redis
REDIS_URL=redis://redis:6379/0

# JWT RS256 keys — generate with:
#   python backend/scripts/generate_keys.py
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_ENCODED_PEM
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_ENCODED_PEM

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,http://localhost:8000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Frontend URL (used in OAuth2 callback redirect)
# In development use port 8080; in production use your deployed origin
FRONTEND_URL=http://localhost:8080

# Required for /auth/oauth2-callback (campus SSO login) to work at all.
# The X-Auth-Request-User / X-Auth-Request-Email headers that endpoint
# trusts are otherwise trivial to spoof by anyone with network access to
# this service — leave this unset in development (the dev netid login on
# each app's login page doesn't need it) and only set it once a real
# OAuth2 reverse proxy is deployed in front of this service, configured
# with the same secret and set to strip any client-supplied copy of it.
OAUTH2_PROXY_SHARED_SECRET=

# Bootstrap admin account — created automatically on first startup.
# Once an admin user exists these values are ignored and can be removed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# --- RAG (docs/design-rag.md §9.3) ---
# Service URLs on the compose network (these defaults rarely need changing)
OLLAMA_URL=http://ollama:11434
INFINITY_URL=http://infinity:7997
CHROMA_URL=http://chromadb:8000

# Embedding models Infinity loads, separated by ';'. A laptop with ~8 GB for
# Docker should serve MiniLM only. On the 16 GB VM, serve both, because the
# embedding-alt profile and T6's re-run need gte-Qwen2:
# INFINITY_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2;Alibaba-NLP/gte-Qwen2-1.5B-instruct
INFINITY_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# The auto-responder's default generation model (pulled by scripts/pull_models.sh)
RAG_DEFAULT_MODEL=qwen2.5:1.5b

# Generation bounds (§8.1, §11.2). If a timed harness run on the VM has a
# call over 120 s or a truncated answer, lower OLLAMA_NUM_PREDICT to 256.
OLLAMA_NUM_PREDICT=512
OLLAMA_TIMEOUT_S=150
COMPARE_BUDGET_S=165
COMPARE_GRACE_S=5

# GitLab access token for shallow-cloning course repositories (read_repository
# scope). A runtime secret: set it only in each machine's .env, never commit
# it, and never make it a GitLab CI/CD variable. It is sent only to these hosts:
GITLAB_TOKEN=
RAG_GIT_HOSTS=git.doit.wisc.edu
# How long a shallow clone may run before it is killed (§7.1).
RAG_CLONE_TIMEOUT_S=120
